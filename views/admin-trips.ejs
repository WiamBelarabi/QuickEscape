<%- include('partials/head', { title, page }) %>
<%- include('partials/nav') %>
<main class="container">
  <section class="page-head">
    <h1>Admin trip management</h1>
    <p class="muted">Create, edit, and remove trips.</p>
  </section>

  <section class="panel">
    <h2>Create or edit a trip</h2>
    <form id="tripForm" class="form">
      <input id="tripId" type="hidden">

      <label for="tripName">Name</label>
      <input id="tripName" name="name" type="text" required>

      <label for="tripDestination">Destination</label>
      <input id="tripDestination" name="destination" type="text" required>

      <label for="tripBudget">Budget</label>
      <input id="tripBudget" name="budget" type="number" step="0.01" required>

      <label for="tripDepart">Departure date</label>
      <input id="tripDepart" name="date_depart" type="date" required>

      <label for="tripReturn">Return date</label>
      <input id="tripReturn" name="date_retour" type="date" required>

      <label for="tripPhoto">Photo URL</label>
      <input id="tripPhoto" name="photo" type="url" required>

      <label for="tripSeats">Seats available</label>
      <input id="tripSeats" name="place_restante" type="number" required>

      <label for="tripDescription">Description</label>
      <textarea id="tripDescription" name="description" rows="4"></textarea>

      <div class="form-actions">
        <button class="button primary" type="submit" id="tripSubmit">Save trip</button>
        <button class="button ghost" type="button" id="tripCancel">Cancel edit</button>
      </div>
      <div id="adminTripsStatus" class="status"></div>
    </form>
  </section>

  <section id="adminTripsList" class="card-grid"></section>
  <div id="adminTripsMsg" class="status"></div>
</main>
<%- include('partials/footer', { pageScript }) %>
