<%- include('partials/head', { title, page }) %>
<%- include('partials/nav') %>
<main class="container auth">
  <section class="panel">
    <h1>Welcome back</h1>
    <p class="muted">Use your account to access trips and reservations.</p>
    <form id="loginForm" class="form">
      <label for="loginUsername">Username</label>
      <input id="loginUsername" name="username" type="text" autocomplete="username" required>

      <label for="loginPassword">Password</label>
      <input id="loginPassword" name="password" type="password" autocomplete="current-password" required>

      <button class="button primary" type="submit">Log in</button>
      <p class="hint">No account? <a href="/signup">Create one</a>.</p>
      <div id="loginStatus" class="status"></div>
    </form>
  </section>
</main>
<%- include('partials/footer', { pageScript }) %>
